[Match]
Name=wlp1s0

[Network]
Address=10.43.0.1/24
DHCPServer=yes
# systemd 256 and later let networkd own net.ipv4.conf.<iface>.forwarding for the
# links it manages, and this rootfs runs 260. Without this, forwarding off this
# interface is turned back off behind zorn-share.sh's back and clients get an
# address, a gateway and no route out -- which is exactly what happened.
IPv4Forwarding=yes
ConfigureWithoutCarrier=yes
IPv6AcceptRA=no
LinkLocalAddressing=no

[DHCPServer]
PoolOffset=10
PoolSize=20
EmitRouter=yes
EmitDNS=yes
DNS=223.5.5.5 119.29.29.29
